# Copy to .env and fill in what you have. Every server is optional except Jev itself:
# anything without a key shows as "no key" in the sidebar and the rest keeps working.

# --- required ---
# Jev, the classifier this demo is built around. It's a paid API; get a key at
# https://console.typesafe.ai/settings/keys. Without one every message gets an error reply.
TYPESAFE_API_KEY=

# --- optional: one per MCP server ---
# Brave Search (https://brave.com/search/api/)
BRAVE_API_KEY=
# Todoist: Settings → Integrations → Developer → API token
TODOIST_API_KEY=
# Home Assistant: enable the MCP Server integration, then create a long-lived access token
# under your profile. HASS_URL is your instance's base URL (scheme, host and port); the app
# appends /api/mcp.
HASS_URL=http://homeassistant.local:8123
HASS_TOKEN=
# TheMealDB. Defaults to the public test key "1", which is for development and educational use.
MEALDB_API_KEY=

# --- optional: behaviour ---
# Jev model. Defaults to jev-latest when unset or blank.
TYPESAFE_MODEL=
# IANA time zone for dates the server works out itself (e.g. Todoist's "tomorrow"). Defaults to
# the server's own zone, which is only right when you run this where you live.
ASSISTANT_TZ=
# Temperature unit assumed when the user doesn't say: fahrenheit (default) or celsius.
DEFAULT_UNITS=

# --- optional: ports and storage ---
# The API server's port and the web dev server's port; both the server and Vite read these.
PORT=8787
WEB_PORT=5173
# SQLite file, relative to apps/server.
DATABASE_PATH=./jev-chat.db
